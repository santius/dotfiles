#!/usr/bin/env bash

FOLDER="$HOME/Pictures/55.04 - Wallpapers"

menu() {
    if command -v nsxiv >/dev/null; then
        CHOICE=$(nsxiv -otb "$FOLDER"/*)
    else
        CHOICE=$(printf "Random\n%s\n" "$(command ls -v "$FOLDER")" | dmenu -c -l 15 -i -p "Wallpaper: ")

        if [ "$CHOICE" != "Random" ] && [ -n "$CHOICE" ]; then
            CHOICE="$FOLDER/$CHOICE"
        fi
    fi

    case "$CHOICE" in
        Random)
            wal -i "$FOLDER"
            ;;
        "")
            exit 0
            ;;
        *)
            wal -i "$CHOICE"
            ;;
    esac
}

case "$#" in
    0) menu ;;
    1) wal -i "$1" ;;
    2) wal -i "$1" --theme "$2" ;;
    *) exit 0 ;;
esac
