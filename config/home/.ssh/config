Include /Users/santiago.hernandez/.config/colima/ssh_config

Host *
    AddKeysToAgent yes
    UseKeychain yes
    PreferredAuthentications publickey
    ServerAliveInterval 60
    ServerAliveCountMax 30
    HashKnownHosts yes
    IdentitiesOnly yes
    Compression yes
    ControlMaster auto
    ControlPath ~/.ssh/sockets/%r@%h:%p
    ControlPersist 10m
    IdentityFile ~/.ssh/id_ed25519
    IdentityFile ~/.ssh/id_rsa

# Personal GitHub
Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519

# GitLab
Host gitlab.com
    HostName gitlab.com
    User git
    IdentityFile ~/.ssh/id_ed25519

# Corporate GitHub
Host github.disney
    HostName github.disney.com
    User HERNS185
    IdentityFile ~/.ssh/id_ed25519_github_alt

# Internal hosts
Host homero
    HostName 10.0.0.21
    User santius
    IdentityFile ~/.ssh/id_rsa

Host 10.0.0.50
    HostName 10.0.0.50
    User root
    IdentityFile ~/.ssh/id_ed25519
