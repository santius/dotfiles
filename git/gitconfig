[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
[user]
	name = Santiago Hernandez
	email = santi84@gmail.com

[core]
	editor = nvim
	excludesfile = ~/.gitignore_global
	whitespace = trailing-space,space-before-tab
	autocrlf = input
	pager = less -FRX

[init]
	defaultBranch = main

[color]
	ui = auto
	diff = auto
	status = auto
	branch = auto

[pull]
	rebase = true

[push]
	default = current
	autoSetupRemote = true

[merge]
	tool = vimdiff
	conflictstyle = diff3
	ff = only

[diff]
	tool = vimdiff
	colorMoved = default

[alias]
	# Shortcuts
	st = status
	ci = commit
	co = checkout
	br = branch
	df = diff
	dc = diff --cached
	lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit

	# Useful aliases
	unstage = reset HEAD --
	last = log -1 HEAD
	amend = commit --amend
	undo = reset --soft HEAD^
	stash-all = stash save --include-untracked

	# Branch management
	branch-clean = "!git branch --merged | grep -v '\\*\\|main\\|master\\|develop' | xargs -n 1 git branch -d"

	# Show changes
	changes = diff --name-status
	who = shortlog -s --

[help]
	autoCorrect = 1

[credential]
	helper = cache --timeout=3600

[fetch]
	prune = true

[rebase]
	autoStash = true

[status]
	showUntrackedFiles = all

[transfer]
	fsckObjects = true
